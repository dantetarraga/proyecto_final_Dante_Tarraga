{
  "name": "proyecto_final_dante_tarraga",
  "version": "1.0.0",
  "private": true,
  "description": "Proyecto final del curso QA Automatizador: pruebas sobre la demo de PrestaShop",
  "author": "Dante Tárraga",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "playwright test --project=chromium --grep-invert @flaky",
    "test:smoke": "playwright test --grep @smoke",
    "test:flaky": "playwright test --grep @flaky --repeat-each 10 --retries 0",
    "test:headed": "playwright test --headed --grep-invert @flaky",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dantetarraga/proyecto_final_Dante_Tarraga.git"
  },
  "bugs": {
    "url": "https://github.com/dantetarraga/proyecto_final_Dante_Tarraga/issues"
  },
  "homepage": "https://github.com/dantetarraga/proyecto_final_Dante_Tarraga#readme",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "dotenv": "^18.0.9",
    "typescript": "^7.0.2"
  }
}
